# ============================================================================
# ObraCalc — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e configure na Vercel (produção).
# Nunca versione arquivos .env reais.
# ============================================================================

# Database
# DATABASE_URL: conexão usada pelo runtime (em produção prefira a URL pooled).
# DIRECT_URL: conexão direta usada apenas por migrações/backups (opcional).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/obracalc?schema=public"
DIRECT_URL=""

# NextAuth - Generate with: npx auth secret
# Em produção AUTH_SECRET deve ter no mínimo 32 caracteres.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Storage persistente
# Em produção use supabase (o disco da Vercel é efêmero).
# STORAGE_DRIVER=supabase
STORAGE_DRIVER=""
STORAGE_LOCAL_DIR=".storage"
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="obracalc"

# Jobs de importação
# Na Vercel o corpo da requisição é limitado a 4,5 MB; use 4194304 ou menos.
IMPORT_MAX_FILE_BYTES="26214400" # 25 MB (self-hosted)
IMPORT_MAX_ROWS="100000"
IMPORT_JOB_MAX_ATTEMPTS="3"
IMPORT_JOB_STALE_MINUTES="15"
IMPORT_CRON_BATCH_SIZE="5"
# Obrigatório em produção. A Vercel envia "Authorization: Bearer $CRON_SECRET".
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Backups externos
# Se as quatro variáveis abaixo estiverem preenchidas, o backup vai para S3.
# Caso contrário, usa o Supabase Storage (STORAGE_DRIVER=supabase).
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
BACKUP_PREFIX="backups"
BACKUP_RETENTION_DAYS="30"

# AI Providers (optional - leave empty to disable)
# Chave mestra para criptografar as chaves de API (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se vazia, a chave é derivada de AUTH_SECRET.
AI_ENCRYPTION_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""

# Cliente PostgreSQL (scripts de backup/restauração fora da Vercel)
# Opcional: caminho para o diretório bin do PostgreSQL.
PG_BIN=""
