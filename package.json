{
  "name": "obracalc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "vercel-build": "npx prisma generate && tsx scripts/migrate-deploy.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:prod": "tsx scripts/migrate-deploy.ts",
    "db:push": "npx prisma db push",
    "db:seed": "npx prisma db seed",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:performance": "vitest run src/lib/services/__tests__/performance.test.ts",
    "test:security": "vitest run src/lib/__tests__/security.test.ts",
    "security:secrets": "tsx scripts/check-secrets.ts",
    "env:check": "tsx scripts/check-env.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:prune": "tsx scripts/backup.ts --prune",
    "backup:verify": "tsx scripts/verify-restore.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-table": "^9.3.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "prisma": "6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
